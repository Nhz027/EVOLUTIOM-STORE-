<!-- CARRINHO -->
<div id="carrinhoBox">

<h3 style="margin-bottom:10px;color:#FF8C00;">
🛒 Carrinho
</h3>

<div id="itensCarrinho" style="
display:flex;
flex-direction:column;
gap:8px;
margin-bottom:15px;
"></div>

<div style="
display:flex;
justify-content:space-between;
margin-bottom:15px;
font-weight:bold;
">
<span>Total:</span>
<span id="totalCarrinho">R$ 0,00</span>
</div>

