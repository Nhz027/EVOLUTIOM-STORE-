<script>

let carrinho = [];

function esconderTudo(){

document.getElementById("kits").style.display="none";
document.getElementById("vips").style.display="none";
document.getElementById("astral").style.display="none";
document.getElementById("lendario").style.display="none";
document.getElementById("god").style.display="none";
document.getElementById("pixGlobal").style.display="none";

}

function mostrar(sec){

esconderTudo();

document.getElementById(sec).style.display="grid";

document.querySelectorAll(".aba").forEach(el=>{
el.classList.remove("ativa");
});

if(sec === "kits"){
document.querySelectorAll(".aba")[0].classList.add("ativa");
}

if(sec === "vips"){
document.querySelectorAll(".aba")[1].classList.add("ativa");
}

}

function abrirVip(id){

esconderTudo();

document.getElementById(id).style.display="block";

}

function adicionarCarrinho(nome,preco){

carrinho.push({
nome,
preco
});

atualizarCarrinho();

alert(nome + " adicionado ao carrinho!");

}

function atualizarCarrinho(){

const box = document.getElementById("carrinhoBox");
const itens = document.getElementById("itensCarrinho");
const total = document.getElementById("totalCarrinho");

itens.innerHTML = "";

let soma = 0;

carrinho.forEach((item,index)=>{

soma += item.preco;

itens.innerHTML += `
<div style="
background:#1a1a1f;
padding:10px;
border-radius:8px;
display:flex;
justify-content:space-between;
align-items:center;
">

<div>
<div style="font-size:14px;">
${item.nome}
</div>

<div style="
color:#FF8C00;
font-weight:bold;
">
R$ ${item.preco.toFixed(2)}
</div>

</div>

<button onclick="removerItem(${index})" style="
background:red;
border:none;
color:white;
padding:5px 8px;
border-radius:6px;
cursor:pointer;
">
X
</button>

</div>
`;

});

total.innerText = `R$ ${soma.toFixed(2)}`;

box.style.display = carrinho.length > 0 ? "block" : "none";

}

function removerItem(index){

carrinho.splice(index,1);

atualizarCarrinho();

}

function finalizarCompra(){

if(carrinho.length <= 0){
alert("Seu carrinho está vazio!");
return;
}

let nomes = carrinho.map(item => item.nome).join(", ");

comprar(nomes);

}

function comprar(nome){

esconderTudo();

document.getElementById("pixGlobal").style.display="block";

document.getElementById("produtoNome").innerText = nome;

}

function copiar(){

navigator.clipboard.writeText(
"efc0f5af-cd44-400c-9426-2d071caa7bec"
);

alert("Pix copiado!");

}

function abrirDiscord(){

window.open(
"https://discord.gg/fPxe5RRec",
"_blank"
);

}

</script>

